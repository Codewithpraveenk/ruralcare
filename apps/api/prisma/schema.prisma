generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Facility {
  id String @id
  name String
  type String
  distanceKm Float
  services String
  available Boolean
  hours String
  address String
  phone String
  latitude Float
  longitude Float
}

model User {
  id String @id
  name String
  email String? @unique
  phone String? @unique
  passwordHash String
  role String
  facilityId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Referral {
  id String @id @default(cuid())
  patientLabel String
  sourceFacility String
  destinationFacility String
  service String
  urgency String
  status String @default("PENDING")
  nextAction String
  createdAt DateTime @default(now())
  demoId String?
  careNeed String?
  followUpDue DateTime?
  updatedAt DateTime?
  clientId String? @unique
  sourceMode String?
  selectedFacilityId String?
  ownerUserId String?
  createdByUserId String?
  assistedByUserId String?
  rerouteStatus String?
  recommendedFacilityId String?
}
