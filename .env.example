# Required for reliable Tamil audio transcription in Brave/Chrome/Edge.
# The deterministic triage and typed-input fallback still work without it.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.4-nano
OPENAI_ASSISTANT_MODEL=gpt-5.4-nano
AI_TIMEOUT_MS=12000
ASSISTANT_AI_TIMEOUT_MS=5000
MAX_ADAPTIVE_QUESTIONS=5
PORT=8787
AUTH_SECRET=replace-with-a-long-random-secret-before-deployment
GOOGLE_CLIENT_ID=
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
DATABASE_URL=file:./ruralcare.db
NODE_ENV=development
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
